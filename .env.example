# Default: accessible on the Docker host at http://localhost:8282.
BIND_ADDRESS=127.0.0.1
PORT=8282
PUBLIC_URL=http://localhost:8282
SECURE_COOKIES=false
TZ=UTC
# Trust only the actual reverse proxy IP(s), comma separated. Do not use *.
FORWARDED_ALLOW_IPS=127.0.0.1
# Never put integration credentials here; configure them through admin Settings.
