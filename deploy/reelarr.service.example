# Direct Python installation on Linux. Adjust User and paths before installing.
[Unit]
Description=Reelarr Plex Calendar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reelarr
WorkingDirectory=/opt/reelarr
Environment=DATA_DIR=/var/lib/reelarr
Environment=PUBLIC_URL=https://calendar.example.com
Environment=FORWARDED_ALLOW_IPS=127.0.0.1
ExecStart=/opt/reelarr/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8282 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/reelarr

[Install]
WantedBy=multi-user.target
